{
  "name": "galex-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic procedural galaxy board — runs on Node, vanilla Three.js, and Vue/TresJS.",
  "exports": {
    "./core/*": "./core/*.ts",
    "./view/*": "./view/*.ts",
    "./view/effects/*": "./view/effects/*.ts",
    "./view-vue": "./view-vue/index.ts",
    "./view-vue/*": "./view-vue/*.ts",
    "./view-vue/components/*.vue": "./view-vue/components/*.vue",
    "./view-vue/composables/*": "./view-vue/composables/*.ts"
  },
  "files": [
    "core",
    "view",
    "view-vue",
    "tsconfig.json",
    "README.md"
  ],
  "peerDependencies": {
    "three": "^0.160.0",
    "vue": "^3.5.0",
    "@tresjs/core": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue": { "optional": true },
    "@tresjs/core": { "optional": true }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vue-tsc --noEmit && tsx tools/CheckDeterminism.ts && tsx --test core/*.test.ts view/**/*.test.ts view-vue/**/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:determinism": "tsx tools/CheckDeterminism.ts",
    "test:cross": "playwright test",
    "example:server": "tsx tools/server-example/Index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tresjs/core": "^5.8.0",
    "@types/node": "^25.6.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "three": "^0.160.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  }
}
